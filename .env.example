# ─── REQUIRED ────────────────────────────────────────────────
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here_change_this

# ─── PAYMENTS (Stripe) ───────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs - create these in your Stripe dashboard
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_GROWTH_PRICE_ID=price_...
STRIPE_BUSINESS_PRICE_ID=price_...

# ─── EMAIL (SendGrid) ────────────────────────────────────────
# Get from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG....
EMAIL_FROM=hello@yourdomain.com
EMAIL_FROM_NAME=NexusAI

# ─── WHATSAPP (Meta Business API) ────────────────────────────
# Get from: https://developers.facebook.com
WHATSAPP_TOKEN=your_whatsapp_token
WHATSAPP_VERIFY_TOKEN=nexusai_verify_2024
WHATSAPP_PHONE_ID=your_phone_number_id

# ─── FACEBOOK / INSTAGRAM ────────────────────────────────────
FACEBOOK_APP_ID=your_fb_app_id
FACEBOOK_APP_SECRET=your_fb_app_secret

# ─── OPTIONAL INTEGRATIONS ───────────────────────────────────
OPENAI_API_KEY=         # For Whisper voice transcription
ELEVENLABS_API_KEY=     # For voice replies (premium feature)
CAL_API_KEY=            # For appointment booking (cal.com)

# ─── APP SETTINGS ────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
ENVIRONMENT=development  # development | production

# ─── FRONTEND (create frontend/.env.local with these) ────────
# Required for local dev — tells the browser where the backend is
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
